FROM python:3.12-slim

WORKDIR /app

ARG BBP_PAIRINGS_VERSION=v6.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git ca-certificates \
    && git clone --depth 1 --branch ${BBP_PAIRINGS_VERSION} https://github.com/BieremaBoyzProgramming/bbpPairings.git /tmp/bbpPairings \
    && make -C /tmp/bbpPairings \
    && cp /tmp/bbpPairings/bbpPairings.exe /usr/local/bin/bbpPairings \
    && chmod +x /usr/local/bin/bbpPairings \
    && rm -rf /tmp/bbpPairings /var/lib/apt/lists/*

RUN pip install poetry --no-cache-dir

COPY pyproject.toml poetry.lock* ./

RUN poetry config virtualenvs.create false \
    && poetry install --no-root --without dev

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
